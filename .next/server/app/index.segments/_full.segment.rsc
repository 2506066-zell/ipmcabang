1a:["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n            // Typewriter effect\n            const texts = [\"Platform Digital Kader IPM\",\"Perpustakaan Digital Pelajar\",\"Ruang Belajar Bersama\",\"Forum Diskusi Intelektual\"];\n            let tIdx = 0, cIdx = 0, deleting = false;\n            const el = document.getElementById('typewriter');\n            function typewriter() {\n              if (!el) return;\n              const cur = texts[tIdx];\n              el.textContent = cur.slice(0, cIdx);\n              if (!deleting) {\n                cIdx++;\n                if (cIdx > cur.length) { deleting = true; setTimeout(typewriter, 2000); return; }\n              } else {\n                cIdx--;\n                if (cIdx < 0) { deleting = false; tIdx = (tIdx + 1) % texts.length; cIdx = 0; }\n              }\n              setTimeout(typewriter, deleting ? 50 : 80);\n            }\n            typewriter();\n          "}}]
